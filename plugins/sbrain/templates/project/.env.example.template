# .env.example — generated by sbrain bootstrap (Step 4b).
#
# Each block below is guarded by a comment naming the ARCHITECTURE.md concern it
# belongs to. When filling this template: keep a block only if that concern is
# `Enabled? = yes` in ARCHITECTURE.md; delete the whole block (including its header
# comment) otherwise. Never leave a block half-filled with placeholder values for a
# disabled concern — an unused var here is as misleading as a missing one.

# --- Compose (always) ---
COMPOSE_PROJECT_NAME=[project-slug-from-step-1]

# --- Core (always, stack-nestjs) ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://[user]:[password]@localhost:5432/[db_name]

# --- Cache (only if "Cache: Redis" was chosen) ---
REDIS_URL=redis://localhost:6379

# --- Queue (only if "Queue: BullMQ" was chosen) ---
QUEUE_REDIS_URL=redis://localhost:6379

# --- §L LDAP auth (only if Auth = "LDAP + breakglass") ---
LDAP_URL=ldap://[host]:389
LDAP_BIND_DN=[service-bind-dn]
LDAP_BIND_PASSWORD=[secret]
LDAP_BASE_DN=[base-dn]
LDAP_USER_FILTER=[filter, e.g. (uid={{username}})]
LDAP_GROUP_ATTR=memberOf

# --- §B Breakglass (only if Auth = "LDAP + breakglass") ---
BREAKGLASS_USERNAME=[not a real name — a role handle, e.g. breakglass-admin]
BREAKGLASS_PASSWORD_HASH=[bcrypt hash — never a plaintext password, even here]

# --- §F File storage — MinIO (only if File storage = "MinIO self-hosted") ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=[access-key]
MINIO_SECRET_KEY=[secret-key]
MINIO_BUCKET=[bucket-name]
MINIO_USE_SSL=false

# --- §F File storage — S3-compatible cloud (only if that option was chosen instead) ---
S3_ENDPOINT=[provider-endpoint]
S3_REGION=[region]
S3_ACCESS_KEY=[access-key]
S3_SECRET_KEY=[secret-key]
S3_BUCKET=[bucket-name]

# --- Auth (only if Auth = "JWT dual-token", i.e. no LDAP) ---
JWT_ACCESS_SECRET=[secret]
JWT_REFRESH_SECRET=[secret]
